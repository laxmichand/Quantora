# ============================================
# Quantora — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ============================================
#  COMMON (shared across all apps)
# ============================================
NODE_ENV=development
REDIS_URL=redis://localhost:6379

# ============================================
#  API (apps/api-nest)
# ============================================
PORT=3000
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
JWT_SECRET=[GENERATE-A-RANDOM-SECRET-KEY]
JWT_EXPIRES_IN=15m
BCRYPT_PEPPER=

# Auth — Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:4200

# Auth — Token Config
REFRESH_TOKEN_EXPIRY_DAYS=7

# Market Data — DhanHQ (Sprint 4)
# Get credentials at https://dhanhq.co/developer-docs
# DHAN_CLIENT_ID and DHAN_ACCESS_TOKEN are REQUIRED (fail-fast at startup outside tests).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional: enable token refresh / re-auth when the access token expires.
DHAN_REFRESH_TOKEN=
DHAN_CLIENT_SECRET=
# Optional overrides (defaults shown):
# DHAN_BASE_URL=https://api.dhanhq.co/v2
# DHAN_TIMEOUT_MS=15000
# DHAN_MAX_RETRIES=3
# DHAN_RETRY_BASE_DELAY_MS=250

# AI Service
OPENAI_API_KEY=sk-[YOUR-KEY]
AI_SERVICE_URL=http://localhost:8000

# ============================================
#  AI SERVICE (apps/ai-fastapi)
# ============================================
# REDIS_URL — same as COMMON above
# OPENAI_API_KEY — same as API above
