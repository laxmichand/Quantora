# ============================================
# Quantora — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ============================================
#  COMMON (shared across all apps)
# ============================================
NODE_ENV=development
REDIS_URL=redis://localhost:6379

# ============================================
#  API (apps/api-nest)
# ============================================
PORT=3000
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
MONGODB_URL=mongodb+srv://[USERNAME]:[PASSWORD]@[CLUSTER].mongodb.net/quantora
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
JWT_SECRET=[GENERATE-A-RANDOM-SECRET-KEY]
JWT_EXPIRES_IN=7d
BCRYPT_PEPPER=

# Auth — Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:4200

# Auth — Token Config
REFRESH_TOKEN_EXPIRY_DAYS=7

# AI Service
OPENAI_API_KEY=sk-[YOUR-KEY]
AI_SERVICE_URL=http://localhost:8000

# ============================================
#  AI SERVICE (apps/ai-fastapi)
# ============================================
# MONGODB_URL — same as API above
# REDIS_URL — same as COMMON above
# OPENAI_API_KEY — same as API above
