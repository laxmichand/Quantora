// Quantora - Prisma Schema
// PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTH
// ============================================

model User {
  id               String  @id @default(uuid())
  email            String  @unique
  passwordHash     String? @map("password_hash")
  name             String
  phone            String?
  role             String  @default("user") // user, pro, admin
  isActive         Boolean @default(true) @map("is_active")
  isEmailVerified  Boolean @default(false) @map("is_email_verified")
  emailVerifyToken String? @map("email_verify_token")

  // OAuth fields
  provider   String? // "google", "local"
  providerId String? @map("provider_id")

  // Account lockout
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  // MFA
  mfaEnabled  Boolean  @default(false) @map("mfa_enabled")
  mfaSecret   String?  @map("mfa_secret")
  mfaMethod   String?  @map("mfa_method")
  mfaPhone    String?  @map("mfa_phone")
  backupCodes String?  @map("backup_codes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)
  isDeleted Boolean  @default(false) @map("is_deleted")

  // IAM fields
  lastLoginAt DateTime? @map("last_login_at")

  // Relations
  portfolios     Portfolio[]
  goals          Goal[]
  alerts         Alert[]
  watchlists     Watchlist[]
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]
  loginHistories LoginHistory[]
  notifications  Notification[]
  oauthAccounts  OAuthAccount[]
  devices        Device[]
  sessions       Session[]
  securityEvents SecurityEvent[]
  subscription   Subscription?
  preferences    UserPreference?

  @@index([email])
  @@index([role])
  @@index([provider, providerId])
  @@index([isDeleted])
  @@map("users")
}

// ============================================
// DEVICES
// ============================================

model Device {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  deviceId           String   @unique @map("device_id")

  fingerprintHash    String?  @map("fingerprint_hash")
  deviceName         String?  @map("device_name")
  deviceType         String?  @map("device_type")

  browser            String?
  browserVersion     String?  @map("browser_version")
  engine             String?
  engineVersion      String?  @map("engine_version")

  os                 String?
  osVersion          String?  @map("os_version")
  platform           String?
  cpuArchitecture    String?  @map("cpu_architecture")

  hostname           String?
  manufacturer       String?
  model              String?
  hardwareConcurrency Int?   @map("hardware_concurrency")
  deviceMemory       Float?  @map("device_memory")

  screenResolution   String?  @map("screen_resolution")
  viewport           String?
  pixelRatio         Float?   @map("pixel_ratio")

  timezone           String?
  language           String?
  languages          String[]
  country            String?
  state              String?
  city               String?
  postalCode         String?  @map("postal_code")
  latitude           Float?
  longitude          Float?

  publicIp           String?  @map("public_ip")
  privateIp          String?  @map("private_ip")
  isp                String?
  networkType        String?  @map("network_type")
  wifiName           String?  @map("wifi_name")

  vpnDetected        Boolean  @default(false) @map("vpn_detected")
  proxyDetected      Boolean  @default(false) @map("proxy_detected")
  torDetected        Boolean  @default(false) @map("tor_detected")

  webglVendor        String?  @map("webgl_vendor")
  webglRenderer      String?  @map("webgl_renderer")
  canvasFingerprint  String?  @map("canvas_fingerprint")
  audioFingerprint   String?  @map("audio_fingerprint")
  fontsHash          String?  @map("fonts_hash")
  pluginsHash        String?  @map("plugins_hash")

  touchSupport       Boolean  @default(false) @map("touch_support")
  cookiesEnabled     Boolean  @default(false) @map("cookies_enabled")
  localStorage       Boolean  @default(false) @map("local_storage")
  sessionStorage     Boolean  @default(false) @map("session_storage")
  batterySupported   Boolean  @default(false) @map("battery_supported")
  batteryLevel       Float?   @map("battery_level")
  charging           Boolean?
  connectionDownlink Float?   @map("connection_downlink")
  effectiveNetworkType String? @map("effective_network_type")

  userAgent          String?  @map("user_agent")
  acceptLanguage     String?  @map("accept_language")
  acceptEncoding     String?  @map("accept_encoding")
  acceptHeader       String?  @map("accept_header")
  referer            String?
  origin             String?

  loginMethod        String?  @default("local") @map("login_method")
  oauthProvider      String?  @map("oauth_provider")
  biometricEnabled   Boolean  @default(false) @map("biometric_enabled")
  mfaEnabled         Boolean  @default(false) @map("mfa_enabled")

  trustedDevice      Boolean  @default(false) @map("trusted_device")
  trustedUntil       DateTime? @map("trusted_until")
  riskScore          Int      @default(0) @map("risk_score")
  riskLevel          String   @default("low") @map("risk_level")

  firstLogin         DateTime? @map("first_login")
  lastLogin          DateTime? @map("last_login")
  lastActivity       DateTime? @map("last_activity")
  loginCount         Int      @default(1) @map("login_count")
  failedLoginCount   Int      @default(0) @map("failed_login_count")

  status             String   @default("active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions           Session[]

  @@index([userId])
  @@index([deviceId])
  @@index([fingerprintHash])
  @@index([publicIp])
  @@index([country])
  @@index([riskLevel])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("devices")
}

// ============================================
// SESSIONS
// ============================================

model Session {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  deviceId           String    @map("device_id")
  sessionToken       String    @unique @map("session_token")

  accessTokenId      String?   @unique @map("access_token_id")
  refreshTokenId     String?   @unique @map("refresh_token_id")
  refreshTokenHash   String?   @map("refresh_token_hash")
  previousRefreshTokenHash String? @map("previous_refresh_token_hash")
  csrfToken          String?   @map("csrf_token")

  loginTime          DateTime  @default(now()) @map("login_time")
  lastActivity       DateTime  @default(now()) @map("last_activity")
  expiresAt          DateTime  @map("expires_at")
  idleTimeout        DateTime? @map("idle_timeout")
  absoluteTimeout    DateTime? @map("absolute_timeout")
  logoutTime         DateTime? @map("logout_time")

  logoutReason       String?   @map("logout_reason")
  revoked            Boolean   @default(false)
  revokedBy          String?   @map("revoked_by")
  revokedIp          String?   @map("revoked_ip")
  revokedDevice      String?   @map("revoked_device")

  isCurrent          Boolean   @default(false) @map("is_current")
  ipAddress          String?   @map("ip_address")
  country            String?
  city               String?
  userAgent          String?   @map("user_agent")

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device             Device    @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([deviceId])
  @@index([sessionToken])
  @@index([refreshTokenHash])
  @@index([revoked])
  @@index([expiresAt])
  @@index([lastActivity(sort: Desc)])
  @@index([loginTime(sort: Desc)])
  @@map("sessions")
}

// ============================================
// PORTFOLIOS
// ============================================

model Portfolio {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String   @default("My Portfolio")
  benchmark String   @default("NIFTY_50")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)
  isDeleted Boolean  @default(false) @map("is_deleted")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings Holding[]

  @@index([userId])
  @@index([isDeleted])
  @@map("portfolios")
}

model Holding {
  id          String   @id @default(uuid())
  portfolioId String   @map("portfolio_id")
  stockSymbol String   @map("stock_symbol")
  quantity    Int
  avgBuyPrice Decimal  @map("avg_buy_price") @db.Decimal(10, 2)
  addedAt     DateTime @default(now()) @map("added_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")
  version     Int      @default(1)
  isDeleted   Boolean  @default(false) @map("is_deleted")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([stockSymbol])
  @@index([isDeleted])
  @@map("holdings")
}

// ============================================
// GOALS
// ============================================

model Goal {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  targetAmount  Decimal  @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal  @default(0) @map("current_amount") @db.Decimal(15, 2)
  deadline      DateTime @db.Date
  type          String
  sipAmount     Decimal? @map("sip_amount") @db.Decimal(10, 2)
  riskTolerance String   @default("moderate") @map("risk_tolerance")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String?  @map("created_by")
  updatedBy     String?  @map("updated_by")
  version       Int      @default(1)
  isDeleted     Boolean  @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([isDeleted])
  @@map("goals")
}

// ============================================
// SUBSCRIPTIONS
// ============================================

model Subscription {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  plan          String    @default("free")
  status        String    @default("active")
  startDate     DateTime  @default(now()) @map("start_date")
  endDate       DateTime? @map("end_date")
  paymentMethod String?   @map("payment_method")
  amount        Decimal?  @db.Decimal(10, 2)
  currency      String    @default("INR")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")
  version       Int       @default(1)
  isDeleted     Boolean   @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([plan])
  @@index([isDeleted])
  @@map("subscriptions")
}

// ============================================
// ALERTS & WATCHLISTS
// ============================================

model Alert {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String
  stockSymbol     String?   @map("stock_symbol")
  condition       String
  threshold       Decimal?  @db.Decimal(10, 2)
  isActive        Boolean   @default(true) @map("is_active")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")
  version         Int       @default(1)
  isDeleted       Boolean   @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stockSymbol])
  @@index([isActive])
  @@index([isDeleted])
  @@map("alerts")
}

model Watchlist {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  name         String   @default("My Watchlist")
  stockSymbols String[] @map("stock_symbols")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by")
  updatedBy    String?  @map("updated_by")
  version      Int      @default(1)
  isDeleted    Boolean  @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDeleted])
  @@map("watchlists")
}

// ============================================
// REFRESH TOKENS (legacy — sessions now primary)
// ============================================

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  deviceType String?  @default("web") @map("device_type")
  browser    String?  @map("browser")
  os         String?  @map("os")
  deviceName String?  @map("device_name")
  city       String?  @map("city")
  country    String?  @map("country")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// LOGIN HISTORY (Enhanced)
// ============================================

model LoginHistory {
  id              String    @id @default(uuid())
  userId          String?   @map("user_id")
  email           String
  success         Boolean

  provider        String    @default("local")
  loginMethod     String?   @map("login_method")
  failureReason   String?   @map("failure_reason")
  mfaMethod       String?   @map("mfa_method")
  mfaSuccess      Boolean?  @map("mfa_success")

  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  deviceId        String?   @map("device_id")
  deviceName      String?   @map("device_name")
  deviceType      String?   @map("device_type")
  browser         String?
  os              String?
  city            String?
  country         String?
  isp             String?
  ispOrganization String?   @map("isp_organization")

  latitude        Float?
  longitude       Float?
  timezone        String?

  vpnDetected     Boolean   @default(false) @map("vpn_detected")
  proxyDetected   Boolean   @default(false) @map("proxy_detected")
  torDetected     Boolean   @default(false) @map("tor_detected")
  isNewDevice     Boolean   @default(false) @map("is_new_device")
  isNewCountry    Boolean   @default(false) @map("is_new_country")
  isNewIp         Boolean   @default(false) @map("is_new_ip")
  riskScore       Int       @default(0) @map("risk_score")
  riskLevel       String    @default("low") @map("risk_level")
  riskFactors     Json?     @map("risk_factors")

  sessionId       String?   @map("session_id")

  createdAt       DateTime  @default(now()) @map("created_at")

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
  @@index([deviceId])
  @@index([ipAddress])
  @@index([country])
  @@index([riskLevel])
  @@index([createdAt(sort: Desc)])
  @@map("login_history")
}

// ============================================
// AUDIT LOGS (Enhanced)
// ============================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")

  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")

  details   Json?
  reason    String?

  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  deviceId  String?  @map("device_id")
  sessionId String?  @map("session_id")

  country   String?
  city      String?

  severity  String   @default("info")
  riskScore Int      @default(0) @map("risk_score")

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([ipAddress])
  @@index([severity])
  @@index([createdAt(sort: Desc)])
  @@index([deviceId])
  @@index([sessionId])
  @@map("audit_logs")
}

// ============================================
// SECURITY EVENTS
// ============================================

model SecurityEvent {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")

  eventType      String   @map("event_type")
  severity       String    @default("info")
  description    String?
  metadata       Json?

  riskScore      Int       @default(0) @map("risk_score")

  deviceId       String?   @map("device_id")
  sessionId      String?   @map("session_id")
  ipAddress      String?   @map("ip_address")
  country        String?
  city           String?

  emailSent      Boolean   @default(false) @map("email_sent")
  pushSent       Boolean   @default(false) @map("push_sent")
  emailSentAt    DateTime? @map("email_sent_at")
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime? @map("acknowledged_at")

  createdAt      DateTime  @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([severity])
  @@index([deviceId])
  @@index([createdAt(sort: Desc)])
  @@map("security_events")
}

// ============================================
// USER PREFERENCES
// ============================================

model UserPreference {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  language     String @default("en")
  theme        String @default("slate")
  dateFormat   String @default("DD/MM/YYYY") @map("date_format")
  numberFormat String @default("indian") @map("number_format")
  timezone     String @default("Asia/Kolkata")

  notificationsEmail Boolean @default(true) @map("notifications_email")
  notificationsPush  Boolean @default(true) @map("notifications_push")
  notificationsSms   Boolean @default(false) @map("notifications_sms")
  notifyPriceAlerts  Boolean @default(true) @map("notify_price_alerts")
  notifyPortfolio    Boolean @default(true) @map("notify_portfolio")
  notifyNews         Boolean @default(false) @map("notify_news")
  notifyAiInsights   Boolean @default(true) @map("notify_ai_insights")

  defaultExchange String @default("NSE") @map("default_exchange")
  riskTolerance   String @default("moderate") @map("risk_tolerance")
  investmentStyle String @default("long_term") @map("investment_style")

  sidebarCollapsed Boolean @default(false) @map("sidebar_collapsed")
  defaultView      String  @default("dashboard") @map("default_view")
  stockListColumns Json?   @map("stock_list_columns")
  dashboardLayout  Json?   @map("dashboard_layout")

  profilePublic Boolean @default(false) @map("profile_public")
  showPortfolio Boolean @default(false) @map("show_portfolio")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ============================================
// BLOCKED IPS
// ============================================

model BlockedIp {
  id        String   @id @default(uuid())
  ipAddress String   @map("ip_address")
  userId    String?  @map("user_id") // null = globally blocked
  reason    String?
  blockedBy String?  @map("blocked_by")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@unique([ipAddress, userId])
  @@index([ipAddress])
  @@index([userId])
  @@index([expiresAt])
  @@map("blocked_ips")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String    // email, push, sms
  channel   String    // in_app, email, push, sms
  title     String
  body      String?
  message   String?
  metadata  Json?
  status    String    @default("pending") // pending, sent, failed, read
  readAt    DateTime? @map("read_at")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@index([readAt])
  @@map("notifications")
}

// ============================================
// OAUTH ACCOUNTS
// ============================================

model OAuthAccount {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  provider     String
  providerId   String    @map("provider_id")
  email        String?
  name         String?
  avatarUrl    String?   @map("avatar_url")
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@index([provider])
  @@map("oauth_accounts")
}

// ============================================
// MARKET DATA
// ============================================

model Stock {
  id               String    @id @default(uuid())
  symbol           String    @unique
  name             String
  exchange         String // NSE, BSE
  sector           String
  industry         String?
  instrumentId     String?   @map("instrument_id") // provider instrument id (Angel One OpenAPI scrip token)
  scripToken       String?   @map("scrip_token") // Angel One OpenAPI scrip token
  lotSize          Int?      @map("lot_size") // Angel One OpenAPI lot size
  tickSize         Decimal?  @map("tick_size") // Angel One OpenAPI tick size
  instrumentType   String?   @map("instrument_type") // Angel One OpenAPI instrument type
  exchangeSegment  String?   @map("exchange_segment") // Angel One OpenAPI exch_seg
  provider         String    @default("angel")
  marketCap        Decimal?  @map("market_cap")
  currentPrice     Decimal?  @map("current_price")
  pe               Decimal?  @map("pe")
  pb               Decimal?  @map("pb")
  roe              Decimal?  @map("roe")
  dividendYield    Decimal?  @map("dividend_yield")
  beta             Decimal?
  fiftyTwoWeekHigh Decimal?  @map("fifty_two_week_high")
  fiftyTwoWeekLow  Decimal?  @map("fifty_two_week_low")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  prices StockPrice[]

  @@map("stocks")
}

model StockPrice {
  id            String    @id @default(uuid())
  stockId       String    @map("stock_id")
  stock         Stock     @relation(fields: [stockId], references: [id])
  exchange      String
  symbol        String
  price         Decimal
  open          Decimal
  high          Decimal
  low           Decimal
  previousClose Decimal?  @map("previous_close")
  volume        BigInt?
  oi            BigInt?
  provider      String    @default("angel")
  timestamp     DateTime
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([stockId, timestamp])
  @@index([exchange, symbol, timestamp])
  @@index([stockId, timestamp(sort: Desc)])
  @@map("stock_prices")
}
