{
  "name": "quantora",
  "version": "0.0.1",
  "private": true,
  "description": "Quantora - Intelligent Investing. Simplified.",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bash scripts/dev.sh start",
    "local": "bash scripts/dev.sh local",
    "stop": "bash scripts/dev.sh stop",
    "dev": "bash scripts/dev.sh start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "ajv": "^8.20.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0"
  },
  "overrides": {
    "tar": "^7.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
