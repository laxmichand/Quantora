{
  "name": "quantora",
  "version": "0.0.1",
  "private": true,
  "description": "Quantora - Intelligent Investing. Simplified.",
  "packageManager": "npm@11.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bash scripts/dev.sh start",
    "local": "bash scripts/dev.sh local",
    "stop": "bash scripts/dev.sh stop",
    "dev": "bash scripts/dev.sh start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv": "^8.20.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.3.0",
    "prisma": "^6.19.0",
    "turbo": "^2.4.0",
    "typescript": "~6.0.0"
  },
  "overrides": {
    "tar": "^7.4.3",
    "rxjs": "7.8.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.0.0",
    "@rollup/rollup-darwin-x64": "^4.0.0",
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "rxjs": "7.8.2"
  }
}
