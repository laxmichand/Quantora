{
  "version": 2,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build:prod --workspace=@quantora/web",
  "outputDirectory": "dist/quantora-frontend",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://quantora-ih3a.onrender.com/api/$1"
    },
    {
      "src": "/ai/(.*)",
      "dest": "https://quantora-ai-633n.onrender.com/ai/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}