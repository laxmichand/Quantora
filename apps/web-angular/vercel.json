{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps --ignore-engines",
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist/quantora-frontend/browser",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://quantora-ih3a.onrender.com/api/$1"
    },
    {
      "src": "/ai/(.*)",
      "dest": "https://quantora-ai-633n.onrender.com/ai/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
